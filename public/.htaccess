Options -MultiViews

# The deploy action leaves a manifest of every uploaded file at the site root.
# Served, it hands anyone the whole file tree — including the content admin's
# folder name, which is only useful while it stays unlisted.
<FilesMatch "^\.ftp-deploy-sync-state\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|avif|webp|jpe?g|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # The static build emits a per-route index.html under about/, platforms/ and
  # services/ so crawlers that do not run JS still get that page's own title and
  # description. Left alone, mod_dir would answer /services with a 301 to
  # /services/ — a redirect that contradicts both the canonical tag and the
  # sitemap, which name the slash-less URL. Rewriting here keeps the canonical
  # URL a direct 200.
  RewriteRule ^(%%ROUTE_SLUGS%%)/?$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
